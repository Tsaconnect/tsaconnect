# smart-contracts env template. Copy to .env and fill in. NEVER commit .env.

# ── Deployer ──
DEPLOYER_PRIVATE_KEY=0x...              # funded EOA (tBNB on BSC testnet, S on Sonic)

# ── RPCs (public defaults exist in hardhat.config.js; override only if needed) ──
SONIC_TESTNET_RPC=https://rpc.testnet.soniclabs.com
SONIC_MAINNET_RPC=https://rpc.soniclabs.com
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
SONICSCAN_API_KEY=                      # optional — source verification on SonicScan
BSCSCAN_API_KEY=                        # optional — source verification on BscScan

# ── Chain-level address overrides (deploy/chains.js carries defaults; set here to override) ──
# Sonic Mainnet
MAINNET_MCGP_ADDRESS=
MAINNET_USDT_ADDRESS=
MAINNET_USDC_ADDRESS=
# Sonic Testnet
TESTNET_MCGP_ADDRESS=
TESTNET_USDT_ADDRESS=
TESTNET_USDC_ADDRESS=
# BSC Mainnet
BSC_MAINNET_USDT_ADDRESS=
BSC_MAINNET_USDC_ADDRESS=
# BSC Testnet
BSC_TESTNET_USDT_ADDRESS=
BSC_TESTNET_USDC_ADDRESS=

# ── Deploy-time role/wallet addresses ──
OWNER_ADDRESS=
ADMIN_ADDRESSES=                        # comma-separated
SYSTEM_WALLET_ADDRESS=0xaF326D5D242C9A55590540f14658adDDd3586A8d

# ── Existing proxy addresses (used by upgrade.js and wiring scripts) ──
FEE_MANAGER_ADDRESS=                    # set when wiring escrows to an existing FeeManager

# ── Misc ──
# MINT_TO=                              # scripts/deploy-bsc-test-tokens.js mint recipient
