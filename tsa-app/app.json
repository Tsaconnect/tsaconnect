{
  "expo": {
    "name": "TSA Connect",
    "slug": "TsaApp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tsaconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mcgp.TsaApp",
      "runtimeVersion": "1.1.0",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "TSA Connect uses the camera to photograph your ID document and take the selfie required for identity verification.",
        "NSMicrophoneUsageDescription": "TSA Connect uses the microphone during the video step of identity verification.",
        "NSPhotoLibraryUsageDescription": "TSA Connect needs access to your photos so you can upload product images, proof of payment, and your profile picture.",
        "NSFaceIDUsageDescription": "TSA Connect uses Face ID to unlock the app and to authorise wallet transactions."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.tsaconnectworld.mobile",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "TSA Connect uses the camera to photograph your ID document and take the selfie required for identity verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TSA Connect needs access to your photos so you can upload product images, proof of payment, and your profile picture."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TSA Connect uses Face ID to unlock the app and to authorise wallet transactions."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8961E"
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5cecf6b-afa9-43a6-9f36-f705f3cfac28"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d5cecf6b-afa9-43a6-9f36-f705f3cfac28"
    },
    "owner": "mcgp"
  }
}
