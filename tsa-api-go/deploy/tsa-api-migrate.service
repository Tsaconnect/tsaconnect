# Install to /etc/systemd/system/tsa-api-migrate.service
#
# Runs migrations against the release named in /srv/tsa-api/.release-target, using the
# SAME EnvironmentFile as the service, so both see byte-identical configuration.
[Unit]
Description=TSA Connect API — schema migration (oneshot)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=tsa
Group=tsa
EnvironmentFile=/srv/tsa-api/shared/env
ExecStart=/srv/tsa-api/bin/migrate.sh
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
